# Caddy Environment Configuration
# Copy this file to .env and fill in your actual values
# The .env file is gitignored and will not be committed

# Your domain name (required)
# Example: example.com, mydomain.org, etc.
DOMAIN=example.com

# Email for Let's Encrypt certificate notifications (required)
# You'll receive emails about certificate expiration (though Caddy auto-renews)
EMAIL=admin@example.com

# Optional: Timezone for logs
TZ=Europe/Berlin
